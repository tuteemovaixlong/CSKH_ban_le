{
	admin off
}

{$RETAILOPS_PUBLIC_HOST} {
	# Only this exact DNS name receives a certificate. No on-demand TLS.
	encode zstd gzip
	request_body {
		max_size 16KB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=86400"
	}
	reverse_proxy web:8000 {
		header_up -Authorization
		header_up -Forwarded
		transport http {
			dial_timeout 5s
			response_header_timeout 155s
		}
	}
}
