{
	admin off
}

{$RETAILOPS_PUBLIC_HOST} {
	# Only this exact DNS name receives a certificate. No on-demand TLS.
	encode zstd gzip
	@evidence_upload path /api/order-actions/*/evidence
	request_body @evidence_upload {
		max_size 20MiB
	}
	@chat_upload path /api/chat /api/staff/customer-message
	request_body @chat_upload {
		max_size 27MiB
	}
	@default_body not path /api/order-actions/*/evidence /api/chat /api/staff/customer-message
	request_body @default_body {
		max_size 10MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=86400"
	}
	@internal_routes {
		path /internal /internal/*
	}
	handle @internal_routes {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"not_found","message":"Không tìm thấy đường dẫn."}` 404
	}
	reverse_proxy web:8000 {
		header_up -Authorization
		header_up -Forwarded
		transport http {
			dial_timeout 5s
			response_header_timeout 155s
		}
	}
}
